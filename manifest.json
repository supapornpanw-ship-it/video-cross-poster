{
  "manifest_version": 3,
  "name": "Video Cross-Poster (FB + YT)",
  "version": "1.0.0",
  "description": "Post a video to multiple Facebook pages and one YouTube channel in one click.",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://graph.facebook.com/*",
    "https://graph-video.facebook.com/*",
    "https://rupload.facebook.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://*.vercel.app/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.vercel.app/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Video Cross-Poster"
  }
}
